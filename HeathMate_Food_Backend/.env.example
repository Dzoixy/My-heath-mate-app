# AI provider: gemini OR openai_compatible
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible vision provider
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Firebase Admin service account JSON, stored as ONE LINE in your hosting secret/env var.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Keep true because the Android app already asks users to verify email before food analysis.
REQUIRE_EMAIL_VERIFIED=true

# USDA FoodData Central. DEMO_KEY works for light testing, but a personal key is recommended.
USDA_API_KEY=DEMO_KEY
